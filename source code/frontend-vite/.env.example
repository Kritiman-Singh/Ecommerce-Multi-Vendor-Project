# ==================================================
# FRONTEND ENV TEMPLATE - isko dekh kar Render par env banao
# Render Dashboard -> Static Site -> Environment -> Add Environment Variable:
#   Key   = VITE_API_URL
#   Value = https://your-backend.onrender.com  (backend web service ka URL)
# Ye file (.env.example) git par jayegi, isme secret mat likho.
# ==================================================

# Local development
VITE_API_URL=http://localhost:5454

# Prod (Render static site me ye value dalo, comment hatakar):
# VITE_API_URL=https://your-backend.onrender.com
