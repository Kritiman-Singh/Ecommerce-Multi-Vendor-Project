# ==================================================
# BACKEND ENV TEMPLATE - isko copy karke Render par paste karo
# Render Dashboard -> Web Service -> Environment -> Add Environment Variable
# "Add from .env" / bulk paste me poori file ka content daal sakte ho.
# Ye file (.env.example) git par jayegi, isme REAL secret mat likho.
# REAL values wali `.env` file alag se banao (wo gitignore me hai).
# ==================================================

# Spring profile (Render par hamesha prod)
SPRING_PROFILES_ACTIVE=prod

# Render khud PORT deta hai, phir bhi rakho
PORT=8080
SERVER_PORT=8080

# ---- Database (MySQL - Aiven / PlanetScale / Railway se URL lo) ----
DB_URL=jdbc:mysql://YOUR-MYSQL-HOST:3306/YOUR-DB-NAME?useSSL=true&serverTimezone=UTC
DB_USERNAME=YOUR-DB-USER
DB_PASSWORD=YOUR-DB-PASSWORD
DDL_AUTO=update

# ---- Brevo Email API (Gmail SMTP hata diya gaya hai) ----
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=youremail@yourdomain.com
BREVO_SENDER_NAME=Zentro

# ---- Payment gateways ----
RAZORPAY_API_KEY=rzp_test_xxxxxxxx
RAZORPAY_API_SECRET=your_razorpay_secret
STRIPE_API_KEY=sk_test_xxxxxxxx

# ---- Gemini AI ----
GEMINI_API_KEY=your_gemini_api_key

# ---- JWT (min 32 chars, random strong string banao) ----
JWT_SECRET=change_this_to_a_very_long_random_secret_min_32_chars

# ---- Frontend live URL (CORS ke liye, Render static site ka URL) ----
FRONTEND_URL=https://your-frontend.onrender.com
